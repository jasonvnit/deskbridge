# DeskBridge configuration. Copy to .env (scripts/setup.sh does this for you).
# Wrap values that contain spaces or special characters in single quotes.

# Required. At least 12 characters. This is the only thing protecting your Mac.
DESKBRIDGE_PASSWORD=

# Local server (only reachable through the tunnel; keep the host on 127.0.0.1).
DESKBRIDGE_HOST=127.0.0.1
DESKBRIDGE_PORT=8765

# Sessions: maximum lifetime and idle timeout.
DESKBRIDGE_SESSION_TTL_HOURS=12
DESKBRIDGE_SESSION_IDLE_MINUTES=60

# Default picture settings (each device can change them in Settings).
DESKBRIDGE_STREAM_FPS=15
# JPEG quality, 10-100.
DESKBRIDGE_STREAM_QUALITY=50
# Maximum frame width in pixels; 0 = native resolution.
DESKBRIDGE_STREAM_MAX_WIDTH=1600

# Show a macOS notification when a device connects.
DESKBRIDGE_NOTIFY_ON_CONNECT=true

# Cloudflare Tunnel.
#   named: fixed hostname on your own Cloudflare domain (recommended)
#   quick: random *.trycloudflare.com URL, no domain needed, changes on every start
#   none:  no tunnel, local access only (http://127.0.0.1:8765)
DESKBRIDGE_TUNNEL_MODE=named
DESKBRIDGE_TUNNEL_NAME=deskbridge
DESKBRIDGE_TUNNEL_HOSTNAME=desk.example.com
